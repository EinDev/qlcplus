#include <windows.h>
#include "freezewatchdog_resource.h"

IDI_ICON1 ICON DISCARDABLE "../resources/icons/qlcplus.ico"

// Opts into the v6 side-by-side Common Controls assembly, for themed (rather
// than classic-gray) standard controls in dialogs such as IDD_FREEZE_DIALOG
// below - see qmlui/app.manifest.
1 24 "app.manifest"

// Freeze/hang diagnostic dialog (FreezeWatchdog, see qmlui/freezewatchdog.cpp).
// Uses a plain read-only multiline EDITTEXT control for the backtrace text -
// unlike TaskDialogIndirect's content areas (tried first, then dropped: its
// text turned out not to be genuinely selectable), a read-only Win32 edit
// control natively supports drag-select, double-click word-select, and
// Ctrl+A/Ctrl+C, which is the whole point of this dialog.
IDD_FREEZE_DIALOG DIALOGEX 0, 0, 420, 240
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "QLC+ - Freeze detected"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "QLC+ appears to be frozen. The text below is the diagnostic report - select it (or click Copy) to paste into a bug report.", IDC_STATIC, 7, 7, 406, 24
    EDITTEXT        IDC_FREEZE_EDIT, 7, 34, 406, 168, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Copy to clipboard", IDC_FREEZE_COPY, 7, 210, 110, 14
    DEFPUSHBUTTON   "OK", IDOK, 363, 210, 50, 14
END
